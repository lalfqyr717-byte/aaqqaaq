{
  "version": 1,
  "language": "python",
  "build": {
    "commands": [
      "pip install -r requirements.txt"
    ]
  },
  "start": {
    "command": "bash start.sh"
  },
  "environment": {
    "ALLOWED_HOSTS": "127.0.0.1,localhost,moq.up.railway.app,moqq.up.railway.app,healthcheck.railway.app",
    "TOX_DEBUG": "False",
    "DJANGO_SETTINGS_MODULE": "tox.settings"
  }
}